<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TypeForge.App.Views.TestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
        <Grid Padding="40,16,40,36" RowSpacing="20" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Text="Timed Tests" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                <TextBlock Text="Measure speed and accuracy across countdown durations or custom passages. Timed and custom runs keep course and adaptive unlocks unchanged." FontSize="13" Foreground="{ThemeResource ForgeTextSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <TextBlock Text="Passage:" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.Passages, Mode=OneWay}"
                        DisplayMemberPath="Title"
                        SelectedIndex="{x:Bind ViewModel.SelectedPassageIndex, Mode=TwoWay}"
                        MinWidth="240" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="16" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ForgeCardStyle}" BorderBrush="{ThemeResource ForgePurpleBrush}" BorderThickness="1.5">
                    <StackPanel Spacing="10">
                        <TextBlock Text="1 Minute" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                        <TextBlock Text="Quick burst speed benchmark." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Content="Start 1-Min Test" Style="{StaticResource ForgePrimaryButtonStyle}" HorizontalAlignment="Stretch" Tag="1" Click="StartTimed_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ForgeCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="3 Minutes" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                        <TextBlock Text="Balanced endurance typing check." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Content="Start 3-Min Test" Style="{StaticResource ForgeSecondaryButtonStyle}" HorizontalAlignment="Stretch" Tag="3" Click="StartTimed_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ForgeCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="5 Minutes" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                        <TextBlock Text="Sustained accuracy and speed benchmark." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Content="Start 5-Min Test" Style="{StaticResource ForgeSecondaryButtonStyle}" HorizontalAlignment="Stretch" Tag="5" Click="StartTimed_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource ForgeCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Custom Practice Text" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                    <TextBox
                        Text="{x:Bind ViewModel.CustomText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Paste any paragraph, technical notes, or study text here..."
                        AcceptsReturn="False"
                        TextWrapping="Wrap"
                        MinHeight="96" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource ForgeRedBrush}" />
                    <Button Content="Launch Custom Practice" Style="{StaticResource ForgePrimaryButtonStyle}" HorizontalAlignment="Left" Click="StartCustom_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
