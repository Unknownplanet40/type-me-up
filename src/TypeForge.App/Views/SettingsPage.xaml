<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TypeForge.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
        <Grid Padding="40,16,40,36" RowSpacing="20" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                <TextBlock Text="Configure theme, font sizing, keyboard visualization, daily goals, and typing behavior." FontSize="13" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource ForgeCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Appearance &amp; Keyboard" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Application Theme" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Dark (#0D0D0D Acrylic) default, Light, or Windows system setting." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="190" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" AutomationProperties.Name="Application theme" VerticalAlignment="Center">
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Windows Default" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Typing Text Font Size" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Adjust monospace stream size in Practice view (16px - 48px)." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider Width="180" Minimum="16" Maximum="48" StepFrequency="2" Value="{x:Bind ViewModel.TypingFontSize, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.TypingFontSize, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" VerticalAlignment="Center" Width="28" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Virtual Keyboard Color Mode" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Performance heat (green/yellow/red) or ergonomic finger-zone guide." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="210" SelectedIndex="{x:Bind ViewModel.KeyboardColorModeIndex, Mode=TwoWay}" VerticalAlignment="Center">
                            <ComboBoxItem Content="Performance Heat (Default)" />
                            <ComboBoxItem Content="Finger-Zone Guide" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Show Virtual Keyboard" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Display on-screen QWERTY keyboard during typing sessions." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowVirtualKeyboard, Mode=TwoWay}" OnContent="Visible" OffContent="Hidden" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Keyboard Label Fade Stage" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Gradually fade on-screen key labels to build touch-typing memory without looking." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="210" SelectedIndex="{x:Bind ViewModel.KeyboardFadeStageIndex, Mode=TwoWay}" AutomationProperties.Name="Keyboard label fade stage" VerticalAlignment="Center">
                            <ComboBoxItem Content="Full Labels (Course Auto)" />
                            <ComboBoxItem Content="Unlabeled + F/J Bumps" />
                            <ComboBoxItem Content="Hidden Keyboard" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Ergonomic Finger Guide" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Show hand diagram highlighting the active finger for the next key." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="210" SelectedIndex="{x:Bind ViewModel.FingerGuideModeIndex, Mode=TwoWay}" AutomationProperties.Name="Ergonomic finger guide mode" VerticalAlignment="Center">
                            <ComboBoxItem Content="Course Lessons (Default)" />
                            <ComboBoxItem Content="Always On" />
                            <ComboBoxItem Content="Off" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource ForgeCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Daily Goal &amp; Typing Mechanics" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Daily Practice Goal" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Target active typing duration tracked on the Practice HUD." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="190" SelectedIndex="{x:Bind ViewModel.DailyGoalIndex, Mode=TwoWay}" VerticalAlignment="Center">
                            <ComboBoxItem Content="10 minutes / day" />
                            <ComboBoxItem Content="15 minutes / day" />
                            <ComboBoxItem Content="30 minutes / day" />
                            <ComboBoxItem Content="45 minutes / day" />
                            <ComboBoxItem Content="60 minutes / day" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Audio Keystroke Feedback" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Play subtle switch click on valid stroke and soft tap on mistake." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.SoundEnabled, Mode=TwoWay}" OnContent="Enabled" OffContent="Muted" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Stop on Error (Strict Mode)" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Halt cursor on mistakes until the correct character is typed." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.StopOnError, Mode=TwoWay}" OnContent="Strict" OffContent="Free-Flow" AutomationProperties.Name="Stop on error mode" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Skip ahead when mastered" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Shorten repetitive course drills automatically after 96%+ mastery on earlier steps." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.OptimalDurationEnabled, Mode=TwoWay}" OnContent="Enabled" OffContent="Full" AutomationProperties.Name="Skip ahead when mastered" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Course Pass Gate" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Require minimum accuracy and maximum mistakes before unlocking the next course exercise." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.CoursePassGateEnabled, Mode=TwoWay}" OnContent="Enforced" OffContent="Off" AutomationProperties.Name="Course pass gate" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.CoursePassGateEnabled, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Minimum Course Accuracy" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Accuracy floor required to advance (stricter lesson targets still apply)." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider Width="180" Minimum="50" Maximum="100" StepFrequency="1" Value="{x:Bind ViewModel.CourseMinAccuracy, Mode=TwoWay}" AutomationProperties.Name="Minimum course accuracy" />
                            <TextBlock Text="{x:Bind ViewModel.CourseMinAccuracyLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" VerticalAlignment="Center" Width="40" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.CoursePassGateEnabled, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Maximum Course Mistakes" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Maximum mistakes allowed per exercise before requiring a retry." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider Width="180" Minimum="0" Maximum="50" StepFrequency="1" Value="{x:Bind ViewModel.CourseMaxMistakes, Mode=TwoWay}" AutomationProperties.Name="Maximum course mistakes" />
                            <TextBlock Text="{x:Bind ViewModel.CourseMaxMistakesLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" VerticalAlignment="Center" Width="76" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Adaptive Drill Word Mode" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Choose phonetic Keybr-style pseudo-words or natural English dictionary words." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="210" SelectedIndex="{x:Bind ViewModel.AdaptiveWordModeIndex, Mode=TwoWay}" AutomationProperties.Name="Adaptive word mode" VerticalAlignment="Center">
                            <ComboBoxItem Content="Phonetic Pseudo-Words" />
                            <ComboBoxItem Content="English Dictionary" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Adaptive Unlock Difficulty" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Speed &amp; accuracy thresholds required before unlocking new letters." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="210" SelectedIndex="{x:Bind ViewModel.AdaptiveProfileIndex, Mode=TwoWay}" AutomationProperties.Name="Adaptive difficulty profile" VerticalAlignment="Center">
                            <ComboBoxItem Content="Casual (650ms · 90%)" />
                            <ComboBoxItem Content="Standard (500ms · 95%)" />
                            <ComboBoxItem Content="Pro (350ms · 98%)" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Always Show WPM in Course Lessons" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="By default, early course lessons show accuracy only until the accuracy target is met once." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowWpmInCourse, Mode=TwoWay}" OnContent="Always Show" OffContent="Accuracy First" AutomationProperties.Name="Always show WPM in course lessons" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Pace Caret (Ghost Cursor)" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Show a ghost reference caret moving at a target pace in Practice and Test." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="210" SelectedIndex="{x:Bind ViewModel.PaceCaretModeIndex, Mode=TwoWay}" AutomationProperties.Name="Pace caret mode" VerticalAlignment="Center">
                            <ComboBoxItem Content="Off" />
                            <ComboBoxItem Content="Fixed WPM" />
                            <ComboBoxItem Content="Personal Best" />
                            <ComboBoxItem Content="Last Session" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsFixedPaceCaretSelected, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Fixed Pace Target WPM" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Target words per minute for the Fixed WPM pace caret (10 - 200 WPM)." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider Width="180" Minimum="10" Maximum="200" StepFrequency="5" Value="{x:Bind ViewModel.PaceTargetWpm, Mode=TwoWay}" AutomationProperties.Name="Fixed pace WPM target" />
                            <TextBlock Text="{x:Bind ViewModel.PaceTargetWpm, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" VerticalAlignment="Center" Width="32" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Rhythm Metronome" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Beat guide synced to Target WPM; starts on your first keystroke in Practice and Test." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MetronomeEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" AutomationProperties.Name="Enable rhythm metronome" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.MetronomeEnabled, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Metronome Beat &amp; Target" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Choose per-keystroke or per-word beats, and Fixed WPM or Auto (Personal Avg + 5)." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox Width="150" SelectedIndex="{x:Bind ViewModel.MetronomeBeatModeIndex, Mode=TwoWay}" AutomationProperties.Name="Metronome beat subdivision">
                                <ComboBoxItem Content="Per Keystroke" />
                                <ComboBoxItem Content="Per Word" />
                            </ComboBox>
                            <ComboBox Width="170" SelectedIndex="{x:Bind ViewModel.MetronomeTargetModeIndex, Mode=TwoWay}" AutomationProperties.Name="Metronome target mode">
                                <ComboBoxItem Content="Fixed WPM" />
                                <ComboBoxItem Content="Auto (Avg + 5)" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.MetronomeEnabled, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Metronome Target WPM &amp; Channels" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Fixed/fallback WPM (20 - 120) plus independent Audio Tick and Visual Pulse toggles." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider Width="140" Minimum="20" Maximum="120" StepFrequency="5" Value="{x:Bind ViewModel.MetronomeTargetWpm, Mode=TwoWay}" AutomationProperties.Name="Metronome target WPM" />
                            <TextBlock Text="{x:Bind ViewModel.MetronomeTargetWpm, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" VerticalAlignment="Center" Width="28" />
                            <CheckBox Content="Audio" IsChecked="{x:Bind ViewModel.MetronomeAudioEnabled, Mode=TwoWay}" MinWidth="0" />
                            <CheckBox Content="Visual" IsChecked="{x:Bind ViewModel.MetronomeVisualEnabled, Mode=TwoWay}" MinWidth="0" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Placement Diagnostic" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Run a 60-second common-words check to recalibrate your recommended course and unlocked keys." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Content="Retake 60s Placement Test"
                            Style="{StaticResource ForgeSecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.RetakePlacementTestCommand}"
                            AutomationProperties.Name="Retake 60-second placement test"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource ForgeCardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Updates &amp; What's New" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.InstallModeDisplay, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Content="Check for Updates"
                                Style="{StaticResource ForgeSecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCheckUpdates, Mode=OneWay}"
                                AutomationProperties.Name="Check for updates" />
                            <Button
                                Content="{x:Bind ViewModel.InstallActionText, Mode=OneWay}"
                                Style="{StaticResource ForgePrimaryButtonStyle}"
                                Command="{x:Bind ViewModel.InstallUpdateCommand}"
                                Visibility="{x:Bind ViewModel.CanInstallUpdate, Mode=OneWay}"
                                AutomationProperties.Name="Install update" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource ForgeTextSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <ProgressBar
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.DownloadProgressPercent, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay}"
                        Height="4"
                        Foreground="{ThemeResource ForgePurpleBrush}" />

                    <Border
                        Visibility="{x:Bind ViewModel.HasReleaseNotes, Mode=OneWay}"
                        Background="{ThemeResource ForgeCardInnerBrush}"
                        BorderBrush="{ThemeResource ForgeHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Latest Release Notes" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ReleaseNotesText, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{ThemeResource ForgeTextSecondaryBrush}"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource ForgeCardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#0D0D0D" CornerRadius="10" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Image
                                Source="ms-appx:///Assets/Branding/typeforge-logo-lockup.png"
                                Width="240"
                                Stretch="Uniform"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="TypeForge" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentVersionDisplay, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Privacy &amp; Local Storage" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                        <TextBlock Text="All typing metrics, drills, and SQLite progress stay local on your PC with zero telemetry. Network requests run only when checking GitHub Releases for updates." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource ForgeCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Profiles &amp; Fresh Start" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border
                                x:Name="SettingsProfileAvatar"
                                Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="{ThemeResource ForgePurpleBrush}">
                                <TextBlock
                                    x:Name="SettingsProfileInitials"
                                    Text="D"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="SettingsProfileName" Text="Default" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                                <TextBlock x:Name="SettingsProfileMeta" Text="1 profile on this device" FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox
                                x:Name="ProfileSwitcherCombo"
                                Width="170"
                                SelectionChanged="ProfileSwitcherCombo_SelectionChanged"
                                AutomationProperties.Name="Active user profile" />
                            <Button Content="New Profile" Click="BtnNewProfile_Click" Style="{StaticResource ForgePrimaryButtonStyle}" />
                            <Button Content="Rename" Click="BtnRenameProfile_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource ForgeHairlineBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Fresh Start (Reset Progress)" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                            <TextBlock Text="Clear sessions, stats, course progress, placement, and streaks for this profile while keeping app settings." FontSize="12" Foreground="{ThemeResource ForgeTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                x:Name="BtnResetProgress"
                                Content="Reset Progress"
                                Click="BtnResetProgress_Click" />
                            <Button
                                x:Name="BtnDeleteProfile"
                                Content="Delete Profile"
                                Click="BtnDeleteProfile_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
