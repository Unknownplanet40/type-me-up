<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TypeForge.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ForgeCanvasBrush" Color="#C80D0D0D" />
                    <SolidColorBrush x:Key="ForgeTopBarBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ForgeCardBrush" Color="#BF141418" />
                    <SolidColorBrush x:Key="ForgeCardInnerBrush" Color="#BF19191E" />
                    <SolidColorBrush x:Key="ForgeHairlineBrush" Color="#242429" />
                    <SolidColorBrush x:Key="ForgePillHoverBrush" Color="#1C1C21" />
                    <SolidColorBrush x:Key="ForgePillSelectedBrush" Color="#201A33" />
                    <SolidColorBrush x:Key="ForgeTextPrimaryBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="ForgeTextSecondaryBrush" Color="#A1A1AA" />
                    <SolidColorBrush x:Key="ForgeTextMutedBrush" Color="#8E8E99" />
                    <SolidColorBrush x:Key="ForgeTextDisabledBrush" Color="#6E6E78" />
                    <SolidColorBrush x:Key="ForgePurpleBrush" Color="#A78BFA" />
                    <SolidColorBrush x:Key="ForgePurpleSoftBrush" Color="#26A78BFA" />
                    <SolidColorBrush x:Key="ForgePurpleGlowBrush" Color="#3DA78BFA" />
                    <SolidColorBrush x:Key="ForgeGreenBrush" Color="#34D399" />
                    <SolidColorBrush x:Key="ForgeGreenFillBrush" Color="#13251D" />
                    <SolidColorBrush x:Key="ForgeGreenBorderBrush" Color="#1E4232" />
                    <SolidColorBrush x:Key="ForgeYellowBrush" Color="#FBBF24" />
                    <SolidColorBrush x:Key="ForgeYellowFillBrush" Color="#251E10" />
                    <SolidColorBrush x:Key="ForgeYellowBorderBrush" Color="#473717" />
                    <SolidColorBrush x:Key="ForgeRedBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="ForgeRedFillBrush" Color="#281416" />
                    <SolidColorBrush x:Key="ForgeRedBorderBrush" Color="#4F2024" />
                    <SolidColorBrush x:Key="ForgeKeyNeutralBrush" Color="#18181E" />
                    <SolidColorBrush x:Key="ForgeKeyNeutralBorderBrush" Color="#2E2E38" />
                    <SolidColorBrush x:Key="ForgeFlameBrush" Color="#FB923C" />
                    <SolidColorBrush x:Key="ForgeOverlayBackdropBrush" Color="#B3050508" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ForgeCanvasBrush" Color="#CCFAFAFA" />
                    <SolidColorBrush x:Key="ForgeTopBarBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ForgeCardBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="ForgeCardInnerBrush" Color="#CCF4F4F5" />
                    <SolidColorBrush x:Key="ForgeHairlineBrush" Color="#E4E4E7" />
                    <SolidColorBrush x:Key="ForgePillHoverBrush" Color="#EFEFF1" />
                    <SolidColorBrush x:Key="ForgePillSelectedBrush" Color="#EDE9FE" />
                    <SolidColorBrush x:Key="ForgeTextPrimaryBrush" Color="#18181B" />
                    <SolidColorBrush x:Key="ForgeTextSecondaryBrush" Color="#52525B" />
                    <SolidColorBrush x:Key="ForgeTextMutedBrush" Color="#63636E" />
                    <SolidColorBrush x:Key="ForgeTextDisabledBrush" Color="#7D7D87" />
                    <SolidColorBrush x:Key="ForgePurpleBrush" Color="#7C3AED" />
                    <SolidColorBrush x:Key="ForgePurpleSoftBrush" Color="#1F7C3AED" />
                    <SolidColorBrush x:Key="ForgePurpleGlowBrush" Color="#337C3AED" />
                    <SolidColorBrush x:Key="ForgeGreenBrush" Color="#059669" />
                    <SolidColorBrush x:Key="ForgeGreenFillBrush" Color="#ECFDF5" />
                    <SolidColorBrush x:Key="ForgeGreenBorderBrush" Color="#A7F3D0" />
                    <SolidColorBrush x:Key="ForgeYellowBrush" Color="#D97706" />
                    <SolidColorBrush x:Key="ForgeYellowFillBrush" Color="#FFFBEB" />
                    <SolidColorBrush x:Key="ForgeYellowBorderBrush" Color="#FDE68A" />
                    <SolidColorBrush x:Key="ForgeRedBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="ForgeRedFillBrush" Color="#FEF2F2" />
                    <SolidColorBrush x:Key="ForgeRedBorderBrush" Color="#FECACA" />
                    <SolidColorBrush x:Key="ForgeKeyNeutralBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="ForgeKeyNeutralBorderBrush" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="ForgeFlameBrush" Color="#EA580C" />
                    <SolidColorBrush x:Key="ForgeOverlayBackdropBrush" Color="#8018181B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ForgePrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ForgePurpleBrush}" />
                <Setter Property="Foreground" Value="#0D0D0D" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ForgeSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ForgeCardBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource ForgeTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ForgeHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,9" />
            </Style>

            <Style x:Key="ForgeSubtleIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource ForgeTextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="10,6" />
            </Style>

            <Style x:Key="ForgeCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ForgeCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ForgeHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
