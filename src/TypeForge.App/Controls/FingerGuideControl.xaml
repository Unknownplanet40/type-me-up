<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TypeForge.App.Controls.FingerGuideControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.Name="Ergonomic Finger Guide">

    <Border Background="{ThemeResource ForgeCardBrush}"
            BorderBrush="{ThemeResource ForgeHairlineBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14,12">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       Text="FINGER GUIDE"
                       FontSize="10"
                       FontWeight="SemiBold"
                       CharacterSpacing="60"
                       Foreground="{ThemeResource ForgeTextMutedBrush}"
                       HorizontalAlignment="Center" />

            <Canvas x:Name="HandsCanvas"
                    Width="256"
                    Height="106"
                    HorizontalAlignment="Center">
                <!-- Left Palm -->
                <Rectangle x:Name="LeftPalm"
                           Canvas.Left="14"
                           Canvas.Top="58"
                           Width="84"
                           Height="42"
                           RadiusX="18"
                           RadiusY="18"
                           Fill="{ThemeResource ForgeCardInnerBrush}"
                           Stroke="{ThemeResource ForgeHairlineBrush}"
                           StrokeThickness="1" />

                <!-- Right Palm -->
                <Rectangle x:Name="RightPalm"
                           Canvas.Left="158"
                           Canvas.Top="58"
                           Width="84"
                           Height="42"
                           RadiusX="18"
                           RadiusY="18"
                           Fill="{ThemeResource ForgeCardInnerBrush}"
                           Stroke="{ThemeResource ForgeHairlineBrush}"
                           StrokeThickness="1" />

                <!-- Left Pinky (A) -->
                <Rectangle x:Name="Finger_LeftPinky" Canvas.Left="14" Canvas.Top="24" Width="16" Height="42" RadiusX="8" RadiusY="8" StrokeThickness="1.5" />
                <TextBlock Canvas.Left="18" Canvas.Top="36" Text="A" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" IsHitTestVisible="False" />

                <!-- Left Ring (S) -->
                <Rectangle x:Name="Finger_LeftRing" Canvas.Left="34" Canvas.Top="12" Width="16" Height="52" RadiusX="8" RadiusY="8" StrokeThickness="1.5" />
                <TextBlock Canvas.Left="38" Canvas.Top="28" Text="S" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" IsHitTestVisible="False" />

                <!-- Left Middle (D) -->
                <Rectangle x:Name="Finger_LeftMiddle" Canvas.Left="54" Canvas.Top="6" Width="16" Height="58" RadiusX="8" RadiusY="8" StrokeThickness="1.5" />
                <TextBlock Canvas.Left="58" Canvas.Top="24" Text="D" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" IsHitTestVisible="False" />

                <!-- Left Index (F) -->
                <Rectangle x:Name="Finger_LeftIndex" Canvas.Left="74" Canvas.Top="14" Width="16" Height="50" RadiusX="8" RadiusY="8" StrokeThickness="1.5" />
                <TextBlock Canvas.Left="78" Canvas.Top="30" Text="F" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" IsHitTestVisible="False" />

                <!-- Left Thumb (Space) -->
                <Rectangle x:Name="Finger_LeftThumb" Canvas.Left="96" Canvas.Top="56" Width="24" Height="16" RadiusX="8" RadiusY="8" StrokeThickness="1.5" />

                <!-- Right Thumb (Space) -->
                <Rectangle x:Name="Finger_RightThumb" Canvas.Left="136" Canvas.Top="56" Width="24" Height="16" RadiusX="8" RadiusY="8" StrokeThickness="1.5" />

                <!-- Right Index (J) -->
                <Rectangle x:Name="Finger_RightIndex" Canvas.Left="166" Canvas.Top="14" Width="16" Height="50" RadiusX="8" RadiusY="8" StrokeThickness="1.5" />
                <TextBlock Canvas.Left="170" Canvas.Top="30" Text="J" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" IsHitTestVisible="False" />

                <!-- Right Middle (K) -->
                <Rectangle x:Name="Finger_RightMiddle" Canvas.Left="186" Canvas.Top="6" Width="16" Height="58" RadiusX="8" RadiusY="8" StrokeThickness="1.5" />
                <TextBlock Canvas.Left="190" Canvas.Top="24" Text="K" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" IsHitTestVisible="False" />

                <!-- Right Ring (L) -->
                <Rectangle x:Name="Finger_RightRing" Canvas.Left="206" Canvas.Top="12" Width="16" Height="52" RadiusX="8" RadiusY="8" StrokeThickness="1.5" />
                <TextBlock Canvas.Left="210" Canvas.Top="28" Text="L" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" IsHitTestVisible="False" />

                <!-- Right Pinky (;) -->
                <Rectangle x:Name="Finger_RightPinky" Canvas.Left="226" Canvas.Top="24" Width="16" Height="42" RadiusX="8" RadiusY="8" StrokeThickness="1.5" />
                <TextBlock Canvas.Left="231" Canvas.Top="36" Text=";" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" IsHitTestVisible="False" />
            </Canvas>

            <TextBlock x:Name="HintCaptionText"
                       Text="Use Left Index on home key 'F'"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{ThemeResource ForgeTextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="256"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Border>
</UserControl>
