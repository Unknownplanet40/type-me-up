<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TypeForge.App.Controls.TypingSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TypeForge.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="14">
        <!-- Typing options -->
        <Border Background="{ThemeResource ForgeCardInnerBrush}" BorderBrush="{ThemeResource ForgeHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="6">
                <TextBlock Text="Typing options" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <CheckBox x:Name="ChkStopOnError" Content="Stop cursor on error" />
                    <CheckBox x:Name="ChkForgiveErrors" Content="Forgive errors" />
                    <CheckBox x:Name="ChkSpaceSkipsWords" Content="Space skips words" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Text appearance with Live Animated Preview -->
        <Border Background="{ThemeResource ForgeCardInnerBrush}" BorderBrush="{ThemeResource ForgeHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="Text appearance" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />

                <Border Background="{ThemeResource ForgeCardBrush}" BorderBrush="{ThemeResource ForgeHairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <controls:TypingStreamView x:Name="PreviewStreamView" />
                </Border>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Font:" FontSize="13" Foreground="{ThemeResource ForgeTextSecondaryBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboFont" Grid.Column="1" SelectionChanged="AppearanceCombo_Changed" HorizontalAlignment="Stretch" AutomationProperties.Name="Font selector" />
                    <TextBlock Grid.Column="2" Text="Size:" FontSize="13" Foreground="{ThemeResource ForgeTextSecondaryBrush}" VerticalAlignment="Center" />
                    <Slider x:Name="SliderFontSize" Grid.Column="3" Minimum="16" Maximum="48" StepFrequency="2" ValueChanged="FontSizeSlider_Changed" VerticalAlignment="Center" AutomationProperties.Name="Font size" />
                    <TextBlock x:Name="TxtFontSize" Grid.Column="4" Text="28" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="Whitespace:" FontSize="13" Foreground="{ThemeResource ForgeTextSecondaryBrush}" VerticalAlignment="Center" Width="88" />
                    <RadioButton x:Name="RadioWsNone" Content="No whitespace" GroupName="AppearanceWhitespaceGroup" Tag="None" Checked="AppearanceRadio_Checked" />
                    <RadioButton x:Name="RadioWsBar" Content="Bar whitespace" GroupName="AppearanceWhitespaceGroup" Tag="Bar" Checked="AppearanceRadio_Checked" />
                    <RadioButton x:Name="RadioWsBullet" Content="Bullet whitespace" GroupName="AppearanceWhitespaceGroup" Tag="Bullet" Checked="AppearanceRadio_Checked" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="Cursor shape:" FontSize="13" Foreground="{ThemeResource ForgeTextSecondaryBrush}" VerticalAlignment="Center" Width="88" />
                    <RadioButton x:Name="RadioCurBlock" Content="Block" GroupName="AppearanceCursorShapeGroup" Tag="Block" Checked="AppearanceRadio_Checked" />
                    <RadioButton x:Name="RadioCurBox" Content="Box" GroupName="AppearanceCursorShapeGroup" Tag="Box" Checked="AppearanceRadio_Checked" />
                    <RadioButton x:Name="RadioCurLine" Content="Line" GroupName="AppearanceCursorShapeGroup" Tag="Line" Checked="AppearanceRadio_Checked" />
                    <RadioButton x:Name="RadioCurUnderline" Content="Underline" GroupName="AppearanceCursorShapeGroup" Tag="Underline" Checked="AppearanceRadio_Checked" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="Cursor movement:" FontSize="13" Foreground="{ThemeResource ForgeTextSecondaryBrush}" VerticalAlignment="Center" Width="116" />
                    <RadioButton x:Name="RadioMoveJumping" Content="Jumping" GroupName="AppearanceCursorMoveGroup" Tag="Jumping" Checked="AppearanceRadio_Checked" />
                    <RadioButton x:Name="RadioMoveSmooth" Content="Smooth" GroupName="AppearanceCursorMoveGroup" Tag="Smooth" Checked="AppearanceRadio_Checked" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Sound -->
        <Border Background="{ThemeResource ForgeCardInnerBrush}" BorderBrush="{ThemeResource ForgeHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="Sound" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ForgeTextPrimaryBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="Play sounds:" FontSize="13" Foreground="{ThemeResource ForgeTextSecondaryBrush}" VerticalAlignment="Center" Width="86" />
                    <RadioButton x:Name="RadioSoundNone" Content="No sounds" GroupName="AppearanceSoundModeGroup" Tag="None" />
                    <RadioButton x:Name="RadioSoundErrors" Content="Error sounds only" GroupName="AppearanceSoundModeGroup" Tag="ErrorsOnly" />
                    <RadioButton x:Name="RadioSoundKeys" Content="Key sounds only" GroupName="AppearanceSoundModeGroup" Tag="KeysOnly" />
                    <RadioButton x:Name="RadioSoundAll" Content="All sounds" GroupName="AppearanceSoundModeGroup" Tag="All" />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Volume:" FontSize="13" Foreground="{ThemeResource ForgeTextSecondaryBrush}" VerticalAlignment="Center" />
                    <Slider x:Name="SliderSoundVolume" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="VolumeSlider_Changed" VerticalAlignment="Center" AutomationProperties.Name="Sound volume" />
                    <TextBlock x:Name="TxtSoundVolume" Grid.Column="2" Text="80" FontSize="12" Foreground="{ThemeResource ForgeTextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="Sound theme:" FontSize="13" Foreground="{ThemeResource ForgeTextSecondaryBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboSoundTheme" Grid.Column="4" HorizontalAlignment="Stretch" AutomationProperties.Name="Sound theme selector" />
                    <Button Grid.Column="5" Click="BtnPreviewSound_Click" Padding="9,6" ToolTipService.ToolTip="Preview sound" AutomationProperties.Name="Preview sound">
                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
