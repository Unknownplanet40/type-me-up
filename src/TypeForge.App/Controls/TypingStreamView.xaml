<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TypeForge.App.Controls.TypingStreamView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="StreamScrollViewer"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        IsTabStop="False">
        <Grid x:Name="InnerGrid">
            <Canvas x:Name="CursorOverlayCanvas" IsHitTestVisible="False">
                <Border
                    x:Name="CursorIndicator"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            </Canvas>
            <RichTextBlock
                x:Name="TypingStreamBlock"
                HorizontalAlignment="Stretch"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="28"
                LineHeight="50"
                CharacterSpacing="28"
                TextAlignment="Left"
                IsTextSelectionEnabled="False"
                SizeChanged="TypingStreamBlock_SizeChanged">
                <Paragraph x:Name="StreamParagraph" />
            </RichTextBlock>
        </Grid>
    </ScrollViewer>
</UserControl>
