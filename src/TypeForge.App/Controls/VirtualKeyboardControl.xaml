<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TypeForge.App.Controls.VirtualKeyboardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="KeycapStyle" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{ThemeResource ForgeKeyNeutralBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ForgeKeyNeutralBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="10" HorizontalAlignment="Center">
        <!-- Strict-Mode Wrong Key & Consecutive-Miss Coaching Banner -->
        <Border x:Name="WrongKeyBanner"
                Visibility="Collapsed"
                Background="{ThemeResource ForgeRedFillBrush}"
                BorderBrush="{ThemeResource ForgeRedBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,6"
                HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="WrongKeyText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource ForgeRedBrush}"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock x:Name="WrongKeyFingerHintText"
                           Visibility="Collapsed"
                           FontSize="12"
                           Foreground="{ThemeResource ForgeTextPrimaryBrush}" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="KeyboardRowsPanel" Spacing="6" HorizontalAlignment="Center">
            <!-- Row 1: Numbers -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Border x:Name="Key_Grave" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="`" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_1" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="1" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_2" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="2" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_3" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="3" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_4" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="4" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_5" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="5" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_6" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="6" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_7" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="7" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_8" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="8" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_9" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="9" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_0" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="0" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_Minus" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="-" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_Equal" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="=" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeycapStyle}" Width="74"><TextBlock Text="Backspace" FontSize="10" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </StackPanel>

            <!-- Row 2: Top Row -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Border Style="{StaticResource KeycapStyle}" Width="62"><TextBlock Text="Tab" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_Q" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_Q" Text="Q" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_W" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_W" Text="W" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_E" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_E" Text="E" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_R" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_R" Text="R" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_T" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_T" Text="T" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_Y" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_Y" Text="Y" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_U" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_U" Text="U" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_I" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_I" Text="I" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_O" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_O" Text="O" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_P" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_P" Text="P" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="{}{&#x0a;[" FontSize="9" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeycapStyle}" Width="42"><TextBlock Text="}&#x0a;]" FontSize="9" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeycapStyle}" Width="54"><TextBlock Text="\" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </StackPanel>

            <!-- Row 3: Home Row -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Border Style="{StaticResource KeycapStyle}" Width="74"><TextBlock Text="Caps" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_A" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_A" Text="A" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_S" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_S" Text="S" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_D" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_D" Text="D" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_F" Style="{StaticResource KeycapStyle}" Width="42">
                    <Grid>
                        <TextBlock x:Name="Lbl_F" Text="F" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="4" Height="4" Fill="{ThemeResource ForgeTextSecondaryBrush}" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </Grid>
                </Border>
                <Border x:Name="Key_G" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_G" Text="G" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_H" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_H" Text="H" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_J" Style="{StaticResource KeycapStyle}" Width="42">
                    <Grid>
                        <TextBlock x:Name="Lbl_J" Text="J" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="4" Height="4" Fill="{ThemeResource ForgeTextSecondaryBrush}" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </Grid>
                </Border>
                <Border x:Name="Key_K" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_K" Text="K" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_L" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_L" Text="L" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_Semicolon" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_Semicolon" Text=";" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_Quote" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_Quote" Text="'" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeycapStyle}" Width="78"><TextBlock Text="Enter" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </StackPanel>

            <!-- Row 4: Bottom Row -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Border Style="{StaticResource KeycapStyle}" Width="96"><TextBlock Text="Shift" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_Z" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_Z" Text="Z" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_X" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_X" Text="X" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_C" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_C" Text="C" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_V" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_V" Text="V" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_B" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_B" Text="B" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_N" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_N" Text="N" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_M" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_M" Text="M" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_Comma" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_Comma" Text="," FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_Period" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_Period" Text="." FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_Slash" Style="{StaticResource KeycapStyle}" Width="42"><TextBlock x:Name="Lbl_Slash" Text="/" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeycapStyle}" Width="104"><TextBlock Text="Shift" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </StackPanel>

            <!-- Row 5: Spacebar Row -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Border Style="{StaticResource KeycapStyle}" Width="58"><TextBlock Text="Ctrl" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeycapStyle}" Width="48"><TextBlock Text="Win" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeycapStyle}" Width="48"><TextBlock Text="Alt" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border x:Name="Key_Space" Style="{StaticResource KeycapStyle}" Width="284"><TextBlock x:Name="Lbl_Space" Text="space" FontSize="10" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeycapStyle}" Width="48"><TextBlock Text="Alt" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeycapStyle}" Width="58"><TextBlock Text="Ctrl" FontSize="11" Foreground="{ThemeResource ForgeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </StackPanel>
        </StackPanel>

        <!-- Quiet Finger Indicator (Shown cleanly when Finger-Zone Guide is enabled) -->
        <TextBlock
            x:Name="FingerHintText"
            Visibility="Collapsed"
            FontSize="11"
            Foreground="{ThemeResource ForgeTextSecondaryBrush}"
            HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
